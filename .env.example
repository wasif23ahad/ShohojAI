# HTTP Server & Admin
PORT=8080
LOG_LEVEL=INFO
ADMIN_API_KEY=replace-with-strong-admin-api-key

# Meta Messenger Graph API v26.0
META_APP_SECRET=replace-with-meta-app-secret
META_VERIFY_TOKEN=replace-with-meta-verify-token
META_PAGE_ACCESS_TOKEN=replace-with-meta-page-access-token
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v26.0

# PostgreSQL 16+ (with pgvector and pg_trgm)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/messenger_agent?sslmode=disable

# Redis 7+
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Burst Debouncer Settings
DEBOUNCE_WINDOW=3s
DEBOUNCE_MAX_BATCH=8

# LLM Configuration (Gemini / OpenAI)
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=gemini-2.5-flash
LLM_EMBEDDING_MODEL=text-embedding-004
